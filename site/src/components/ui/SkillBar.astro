---
interface Props {
  name: string;
  percent: number;
  colorClass: string;
}

const { name, percent, colorClass } = Astro.props;
---
<div class="animate-on-scroll">
  <div class="flex justify-between items-center mb-1.5">
    <span class="text-sm font-medium text-gray-700">{name}</span>
    <span class="text-xs text-gray-400 font-medium">{percent}%</span>
  </div>
  <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
    <div
      class={`skill-bar-fill h-full rounded-full transition-[width] duration-700 ease-out ${colorClass}`}
      data-width={percent}
      style="width: 0%"
      role="progressbar"
      aria-valuenow={percent}
      aria-valuemin={0}
      aria-valuemax={100}
      aria-label={name}
    ></div>
  </div>
</div>
