---
interface Props {
  title: string;
  company: string;
  period: string;
  bullets: string[];
}

const { title, company, period, bullets } = Astro.props;
---
<li class="relative pl-8 pb-10 last:pb-0">
  <!-- Timeline dot -->
  <div
    class="absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand ring-4 ring-brand/20"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="animate-on-scroll">
    <div class="flex flex-wrap items-baseline gap-2 mb-2">
      <h3 class="font-serif text-lg text-gray-900">{title}</h3>
      <span class="text-sm text-gray-400">{company}</span>
    </div>
    <p class="text-xs text-brand font-semibold uppercase tracking-wide mb-3">{period}</p>
    <ul class="space-y-1.5">
      {bullets.map((b) => (
        <li class="text-sm text-gray-600 leading-relaxed flex gap-2">
          <span class="mt-1.5 w-1 h-1 rounded-full bg-gray-300 shrink-0" aria-hidden="true"></span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>
</li>
