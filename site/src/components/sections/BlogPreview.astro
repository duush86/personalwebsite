---
import { getCollection } from 'astro:content';
import PostCard from '@components/ui/PostCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<section id="blog" class="py-20 px-8 md:px-16 bg-white">
  <div class="max-w-4xl">
    <!-- Heading -->
    <div class="animate-on-scroll mb-10 flex items-end justify-between">
      <div>
        <p class="text-brand text-xs font-semibold uppercase tracking-widest mb-2">Writing</p>
        <h2 class="font-serif text-3xl md:text-4xl text-gray-900">Latest Posts</h2>
        <div class="w-12 h-0.5 bg-brand mt-4"></div>
      </div>
      <a
        href={`${base}/blog`}
        class="text-sm font-medium text-brand hover:underline flex items-center gap-1 mb-1"
      >
        All posts
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-gray-400 text-sm">No posts published yet. Check back soon!</p>
    )}
  </div>
</section>
