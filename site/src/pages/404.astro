---
import BaseLayout from '@layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="404 — Page not found · Antonio Orozco" description="Page not found">
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <p class="text-brand text-xs font-semibold uppercase tracking-widest mb-4">404</p>
    <h1 class="font-serif text-5xl text-gray-900 mb-4">Page not found</h1>
    <p class="text-gray-500 mb-8 max-w-sm">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href={base}
      class="inline-flex items-center gap-2 bg-brand text-white px-6 py-3 rounded-lg font-medium hover:bg-brand/90 transition-colors text-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      Back to home
    </a>
  </div>
</BaseLayout>
