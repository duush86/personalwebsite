---
import EducationEntry from '@components/ui/EducationEntry.astro';

const entries = [
  {
    title: 'AWS Media & Entertainment: D2C and Broadcast Foundations',
    institution: 'Amazon Web Services',
    period: 'December 2023',
    description: 'Industry certification covering direct-to-consumer streaming architectures, broadcast workflows, and AWS Elemental media services for live and on-demand delivery.',
    open: true,
  },
  {
    title: 'Skills Diploma — Management',
    institution: 'ITESO, Guadalajara',
    period: 'December 2018',
    description: 'Executive development programme covering leadership, organizational strategy, and management skills for technical professionals.',
  },
  {
    title: "Bachelor's Degree — Computer Science, Software Development",
    institution: 'Tecnológico de Monterrey, Morelia',
    period: 'May 2010',
    description: 'Study plan focused on software development, software engineering processes, networking (CISCO CCNA), and artificial intelligence.',
  },
];
---
<section id="education" class="py-20 px-8 md:px-16 bg-white">
  <div class="max-w-4xl">
    <div class="animate-on-scroll mb-10">
      <p class="text-brand text-xs font-semibold uppercase tracking-widest mb-2">Education</p>
      <h2 class="font-serif text-3xl md:text-4xl text-gray-900">Education & Certifications</h2>
      <div class="w-12 h-0.5 bg-brand mt-4"></div>
    </div>

    <div class="animate-on-scroll space-y-3">
      {entries.map((entry) => (
        <EducationEntry
          title={entry.title}
          institution={entry.institution}
          period={entry.period}
          description={entry.description}
          link={entry.link}
          open={entry.open}
        />
      ))}
    </div>
  </div>
</section>
