---
import SkillBar from '@components/ui/SkillBar.astro';

const skills = [
  { name: 'MEDDPICC / Sales Methodology', percent: 90, colorClass: 'bg-brand' },
  { name: 'Discovery & SOW Design', percent: 95, colorClass: 'bg-brand-red' },
  { name: 'Cloud Playout & Broadcast', percent: 90, colorClass: 'bg-brand-yellow' },
  { name: 'HLS / DASH / CMAF', percent: 90, colorClass: 'bg-brand-purple' },
  { name: 'SSAI & Ad Insertion (SCTE-35)', percent: 85, colorClass: 'bg-brand-teal' },
  { name: 'FAST Platform Distribution', percent: 85, colorClass: 'bg-brand-indigo' },
  { name: 'Low-Latency Live Streaming', percent: 85, colorClass: 'bg-brand' },
  { name: 'AWS Elemental / GCP Infra', percent: 80, colorClass: 'bg-brand-red' },
  { name: 'Executive Presentations', percent: 90, colorClass: 'bg-brand-teal' },
];
---
<section id="skills" class="py-20 px-8 md:px-16 bg-sidebar-bg">
  <div class="max-w-4xl">
    <div class="animate-on-scroll mb-10">
      <p class="text-brand text-xs font-semibold uppercase tracking-widest mb-2">Skills</p>
      <h2 class="font-serif text-3xl md:text-4xl text-gray-900">Technical & Sales Skills</h2>
      <div class="w-12 h-0.5 bg-brand mt-4"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
      {skills.map((skill) => (
        <SkillBar name={skill.name} percent={skill.percent} colorClass={skill.colorClass} />
      ))}
    </div>
  </div>
</section>
